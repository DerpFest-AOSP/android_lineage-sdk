android_app {
    name: "DerpFest-SettingsProvider",

    overrides: ["LineageSettingsProvider"],

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],

    certificate: "platform",
    privileged: true,
    privapp_allowlist: "org.derpfest.settingsstorage.xml",
    platform_apis: true,
    system_ext_specific: true,

    aaptflags: [
        "--rename-manifest-package",
        "org.derpfest.settingsstorage",
    ],

    static_libs: [
        "org.lineageos.platform.internal",
    ],
}
